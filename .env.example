# ===== Madrasti settings =====
# Copy this file to ".env" and fill what you need. Never commit the real ".env".

# --- Email verification (Gmail) ---
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an app password:      https://myaccount.google.com/apppasswords
# 3. Write the Gmail address and the 16-letter app password below (no spaces)
# While these two lines are empty the app runs in TEST MODE: no email is sent and the code is shown on screen.
SMTP_USER=
SMTP_PASS=

# Optional mail settings
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM_NAME=Madrasti

# --- Server ---
# PORT=5050
# MONGO_URI=mongodb://127.0.0.1:27017/madrasti

# Path to a portable mongod binary (only used when no MongoDB is already running)
# MONGOD_PATH=
# Path to the cloudflared binary (only used by "npm run share")
# CLOUDFLARED_PATH=

# Secret key for login sessions. Leave it out: a random one is created on first start.
# JWT_SECRET=
